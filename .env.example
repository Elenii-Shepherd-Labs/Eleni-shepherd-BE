NODE_ENV=development
APP_NAME=Elenii Shepherd Backend
PORT=3000
BASE_URL=http://localhost:3000
DOMAIN=localhost
CORS_ORIGIN=*
CORS_CREDENTIALS=false

DATABASE_URL=mongodb://localhost:27017/eleni-shepherd
DATABASE_URL_FALLBACK=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=0
SESSION_MAX_AGE_MS=3600000
SESSION_TTL_SECONDS=3600
SESSION_REDIS_PREFIX=sess:
SESSION_ALLOW_MEMORY_FALLBACK=true
SESSION_REDIS_CONNECT_TIMEOUT_MS=1500

JWT_SECRET=change-me
JWT_EXPIRATION=12h
JWT_REFRESH_TOKEN_SECRET=change-me-too
JWT_REFRESH_TOKEN_EXPIRATION=1d
SESSION_SECRET=change-me-session-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
SUCCESS_REDIRECT_URL=exp://127.0.0.1:8081/--/auth/callback

OPENAI_API_KEY=
GNEWS_API_KEY=
ZOHO_EMAIL_USER=
ZOHO_EMAIL_PASS=
ZOHO_EMAIL_FROM=

VISION_SERVICE_URL=http://localhost:5000
RADIO_BROWSER_BASE_URL=https://de1.api.radio-browser.info

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_SECRET_KEY=
